{% extends 'base.html.twig' %}

{% block title %}Espace Admin{% endblock %}

{% block body %}
    <h1 style="text-align: center;">Bienvenue dans l'espace admin</h1>
    <p style="text-align: center;">Vous pouvez gérer toutes les prestation, suivre toute les commandes</p>

    <div class="espace-client-grid">
    {% for demande in demandes %}
    <div class="espace-Client-card" style= "border: 4px solid {% if demande.etatdemande == 'terminee' %}#48ff00 {% endif %} {% if demande.etatdemande == 'en attente' %}#F5C827 {% endif %} {% if demande.etatdemande == 'refuse' %}#ff0000 {% endif %} {% if demande.etatdemande == 'acceptee' %}#0097FF {% endif %};">
        <div class="espace-Client-card-body">
            <h5 class="espace-Client-card-title">{{ demande.objet }}</h5>
            <p class="espace-Client-card-text">{{ demande.raison }}</p>

            <h5 class="espace-Client-card-title">Rapport :</h5>
            <p class="espace-Client-card-text">{{ demande.commentaire }}</p>
        </div>
        <a class="" type="button" href="{{ path('app_modifier_demande', { 'id': demande.id }) }}">
            Modifier
        </a >
    </div>
    {% endfor %}
    </div>
{% endblock %}