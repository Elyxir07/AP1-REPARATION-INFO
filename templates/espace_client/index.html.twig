{% extends 'base.html.twig' %}

{% block title %}Espace Client{% endblock %}

{% block body %}
    <h1 style="text-align: center;">Bienvenue dans votre espace client</h1>
    <p style="text-align: center;">Vous pouvez gérer vos informations personnelles, suivre vos commandes</p>

<p style="display: flex; gap: 15px; justify-content: center; align-items: center; margin: 0; background-color: #f2f1f1; padding: 10px 15px; border-radius: 10px; width: fit-content; margin-inline: auto;">
    <span style="color: red;">annulée/refusée</span>
    <span style="color: #fec700; text-shadow: 0 0 1px #333;">en cours/en attente</span>
    <span style="color: green;">terminée</span>
    <span style="color: #0097FF;">acceptée</span>
</p>

    <div class="espace-client-grid">
    {% for demande in demandes %}
    <div class="espace-Client-card" style= "border: 4px solid {% if demande.etatdemande == 'terminee' %}#48ff00 {% endif %} {% if demande.etatdemande == 'en attente' %}#F5C827 {% endif %} {% if demande.etatdemande == 'refuse' %}#ff0000 {% endif %} {% if demande.etatdemande == 'acceptee' %}#0097FF {% endif %};">
        <div class="espace-Client-card-body">
            <h5 class="espace-Client-card-title">{{ demande.objet }}</h5>
            <p class="espace-Client-card-text">{{ demande.raison }}</p>

            <h5 class="espace-Client-card-title">Rapport :</h5>
            <p class="espace-Client-card-text">{{ demande.commentaire }}</p>
        </div>
    </div>
    {% endfor %}
    </div>
{% endblock %}
