{% extends 'base.html.twig' %}

{% block body %}
<br/>
<div class="prestations">
    <div class="prestations-i1">
        <img src="{{ asset('/img/prestations/prestations-i1.svg') }}"/>
    </div>
    <div class="prestations-texte">
        <h2><b>Une maintenance complète</b></h2>
        <h2><b>De votre parc informatique</b></h2>
        <br/>
        <h4>Nous nous engageons à maintenir votre parc informatique</h4>
        <h4>en parfait état de fonctionnement, quel que soit votre matériel,</h4>
        <h4>avec une prise en charge complète :</h4>
        <h4>pièces, main-d’œuvre et déplacement inclus.</h4>
        <br/>
        <a class="btn btn-primary btn-lg" href="{{ path('app_creation_demande') }}"><b>Demander une prestation</b></a>
    </div>
    <div class="prestations-tableau">
        <h1><b>Nos prestations</b></h1>

        <table class="table table-hover">
            <thead>
                <tr>
                <th scope="col">Nom</th>
                <th scope="col">Prix</th>
                </tr>
            </thead>

            <tbody>
                {% for prestation in prestations %}
                    <tr class="table-dark">
                        <th scope="row">{{ prestation.nom }}</th>
                        <td>{{ prestation.prix }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <footer class="prestations-footer">Site réalisé par Comeleon | Site internet CMS & sur mesure</footer>
</div>
{% endblock %}
